#!/usr/bin/env python3
"""
mediaplayer.py — wrapper for Waybar custom/media module
Behavior:
  - No player active           → empty output (module hidden)
  - Player active, no lyrics   → show artist - title (original behavior)
  - Player active + lyrics     → show scrolling lyrics via waylyrics DBus
"""

import gi
gi.require_version("Playerctl", "2.0")
from gi.repository import Playerctl, GLib
from gi.repository.Playerctl import Player
import argparse
import logging
import sys
import signal
import json
import os
from typing import List, Optional

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Waylyrics DBus helper
# ---------------------------------------------------------------------------
WAYLYRICS_DBUS_NAME    = "io.github.waylyrics.Waylyrics"
WAYLYRICS_DBUS_PATH    = "/io/github/waylyrics/Waylyrics"
WAYLYRICS_DBUS_IFACE   = "io.github.waylyrics.Waylyrics"

def get_waylyrics_line() -> Optional[str]:
    """
    Query waylyrics daemon for the current lyric line via DBus.
    Returns the lyric string, or None if waylyrics is not running / no lyric.
    """
    try:
        import dbus
        bus  = dbus.SessionBus()
        obj  = bus.get_object(WAYLYRICS_DBUS_NAME, WAYLYRICS_DBUS_PATH)
        iface = dbus.Interface(obj, dbus_interface=WAYLYRICS_DBUS_IFACE)
        line = str(iface.GetCurrentLyric())
        # waylyrics returns empty string or "..." when no lyric available
        if line and line not in ("", "...", "♪"):
            return line
    except Exception:
        pass
    return None

# ---------------------------------------------------------------------------
# Signal handler
# ---------------------------------------------------------------------------
def signal_handler(sig, frame):
    logger.info("Received signal to stop, exiting")
    sys.stdout.write("\n")
    sys.stdout.flush()
    sys.exit(0)

# ---------------------------------------------------------------------------
# Player manager (original logic, extended with lyric injection)
# ---------------------------------------------------------------------------
class PlayerManager:
    def __init__(self, selected_player=None, excluded_player=[]):
        self.manager = Playerctl.PlayerManager()
        self.loop    = GLib.MainLoop()
        self.manager.connect("name-appeared",  lambda *a: self.on_player_appeared(*a))
        self.manager.connect("player-vanished", lambda *a: self.on_player_vanished(*a))

        signal.signal(signal.SIGINT,  signal_handler)
        signal.signal(signal.SIGTERM, signal_handler)
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)

        self.selected_player  = selected_player
        self.excluded_player  = excluded_player.split(',') if excluded_player else []

        # Lyric polling: GLib timeout every 2 seconds when a player is active
        self._lyric_timer_id  = None
        self._current_player  = None   # player object currently being displayed

        self.init_players()

    def init_players(self):
        for player in self.manager.props.player_names:
            if player.name in self.excluded_player:
                continue
            if self.selected_player is not None and self.selected_player != player.name:
                logger.debug(f"{player.name} is not the filtered player, skipping it")
                continue
            self.init_player(player)

    def run(self):
        logger.info("Starting main loop")
        self.loop.run()

    def init_player(self, player):
        logger.info(f"Initialize new player: {player.name}")
        player = Playerctl.Player.new_from_name(player)
        player.connect("playback-status", self.on_playback_status_changed, None)
        player.connect("metadata",        self.on_metadata_changed,        None)
        self.manager.manage_player(player)
        self.on_metadata_changed(player, player.props.metadata)

    def get_players(self) -> List[Player]:
        return self.manager.props.players

    # -----------------------------------------------------------------------
    # Output helpers
    # -----------------------------------------------------------------------
    def write_output(self, text, player):
        logger.debug(f"Writing output: {text}")
        output = {
            "text":  text,
            "class": "custom-" + player.props.player_name,
            "alt":   player.props.player_name,
        }
        sys.stdout.write(json.dumps(output) + "\n")
        sys.stdout.flush()

    def write_lyric_output(self, lyric, player):
        output = {
            "text":    "♪ " + lyric,
            "class":   "custom-" + player.props.player_name + " lyrics",
            "alt":     player.props.player_name,
            "tooltip": f"{player.get_artist()} - {player.get_title()}",
        }
        sys.stdout.write(json.dumps(output) + "\n")
        sys.stdout.flush()

    def clear_output(self):
        sys.stdout.write("\n")
        sys.stdout.flush()

    # -----------------------------------------------------------------------
    # Lyric polling timer
    # -----------------------------------------------------------------------
    def _start_lyric_timer(self, player):
        self._current_player = player
        if self._lyric_timer_id is None:
            self._lyric_timer_id = GLib.timeout_add(2000, self._poll_lyric)
            logger.debug("Lyric polling timer started")

    def _stop_lyric_timer(self):
        if self._lyric_timer_id is not None:
            GLib.source_remove(self._lyric_timer_id)
            self._lyric_timer_id = None
            logger.debug("Lyric polling timer stopped")
        self._current_player = None

    def _poll_lyric(self):
        """Called by GLib timer every 2 s while a player is active."""
        player = self._current_player
        if player is None:
            self._lyric_timer_id = None
            return False  # remove timer

        # Only poll when actually playing
        if player.props.status != "Playing":
            self._lyric_timer_id = GLib.timeout_add(2000, self._poll_lyric)
            return False

        lyric = get_waylyrics_line()
        if lyric:
            self.write_lyric_output(lyric, player)
        else:
            # waylyrics tidak ada / tidak ada lyric → fallback track info
            self._write_track_info(player, player.props.metadata)

        # Re-schedule (return False karena kita reschedule manual biar bisa ganti interval)
        self._lyric_timer_id = GLib.timeout_add(2000, self._poll_lyric)
        return False

    # -----------------------------------------------------------------------
    # Track info builder (original logic)
    # -----------------------------------------------------------------------
    def _write_track_info(self, player, metadata):
        player_name = player.props.player_name
        artist = player.get_artist() or ""
        artist = artist.replace("&", "&amp;")
        title  = player.get_title() or ""
        title  = title.replace("&", "&amp;")

        track_info = ""
        if (player_name == "spotify"
                and "mpris:trackid" in metadata.keys()
                and ":ad:" in player.props.metadata["mpris:trackid"]):
            track_info = "Advertisement"
        elif artist and title:
            track_info = f"{artist} - {title}"
        else:
            track_info = title

        if track_info:
            if player.props.status == "Playing":
                track_info = " " + track_info
            else:
                track_info = " " + track_info

        if track_info:
            self.write_output(track_info, player)

    # -----------------------------------------------------------------------
    # Playerctl callbacks
    # -----------------------------------------------------------------------
    def on_playback_status_changed(self, player, status, _=None):
        logger.debug(f"Playback status changed for {player.props.player_name}: {status}")
        self.on_metadata_changed(player, player.props.metadata)

    def get_first_playing_player(self):
        players = self.get_players()
        if players:
            for player in players[::-1]:
                if player.props.status == "Playing":
                    return player
            return players[0]
        return None

    def show_most_important_player(self):
        current_player = self.get_first_playing_player()
        if current_player is not None:
            self.on_metadata_changed(current_player, current_player.props.metadata)
        else:
            self._stop_lyric_timer()
            self.clear_output()

    def on_metadata_changed(self, player, metadata, _=None):
        logger.debug(f"Metadata changed for {player.props.player_name}")

        current_playing = self.get_first_playing_player()
        if current_playing is None or current_playing.props.player_name == player.props.player_name:
            # Cek dulu apakah waylyrics punya lirik untuk lagu ini
            lyric = get_waylyrics_line() if player.props.status == "Playing" else None
            if lyric:
                self.write_lyric_output(lyric, player)
                self._start_lyric_timer(player)
            else:
                self._stop_lyric_timer()
                self._write_track_info(player, metadata)
                # Kalau player lagi playing, mulai timer buat poll lyric
                # (waylyrics mungkin belum fetch lyric saat metadata baru muncul)
                if player.props.status == "Playing":
                    self._start_lyric_timer(player)
        else:
            logger.debug(f"Other player {current_playing.props.player_name} is playing, skipping")

    def on_player_appeared(self, _, player):
        logger.info(f"Player appeared: {player.name}")
        if player.name in self.excluded_player:
            return
        if self.selected_player is None or player.name == self.selected_player:
            self.init_player(player)

    def on_player_vanished(self, _, player):
        logger.info(f"Player vanished: {player.props.player_name}")
        if (self._current_player is not None
                and self._current_player.props.player_name == player.props.player_name):
            self._stop_lyric_timer()
        self.show_most_important_player()

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def parse_arguments():
    parser = argparse.ArgumentParser()
    parser.add_argument("-v", "--verbose", action="count", default=0)
    parser.add_argument("-x", "--exclude",
                        help="Comma-separated list of excluded players")
    parser.add_argument("--player")
    parser.add_argument("--enable-logging", action="store_true")
    return parser.parse_args()


def main():
    arguments = parse_arguments()

    if arguments.enable_logging:
        logfile = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                               "media-player.log")
        logging.basicConfig(
            filename=logfile, level=logging.DEBUG,
            format="%(asctime)s %(name)s %(levelname)s:%(lineno)d %(message)s")

    logger.setLevel(max((3 - arguments.verbose) * 10, 0))
    logger.info("Creating player manager")

    player = PlayerManager(arguments.player, arguments.exclude)
    player.run()


if __name__ == "__main__":
    main()